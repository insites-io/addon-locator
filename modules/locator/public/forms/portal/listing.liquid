---
name: listing
resource: modules/insites_locator/location
resource_owner: anyone
flash_alert: Error-Listing
flash_notice: Success-Listing
redirect_to: my-locator-listing
fields:
  properties:
    # Profile tab
    location_name:
      validation:
        presence:
          message: Company name is required.
    email:
      validation:
        presence:
          message: Email is required.
        email:
          message: Please use a valid email address.
    phone_number:
      validation:
        presence:
          message: Phone number is required.
    phone_country_code:
    website:
      validation:
        presence:
          message: Website URL is required.
    category_uuid:
      validation:
        presence:
          message: Partner type is required.
    short_description:
      validation:
        presence:
          message: Short description is required.
    long_description:
    location_image:
    image_1:
    # Location tab
    address_1:
      validation:
        presence:
          message: Address 1 is required.
    address_2:
    suburb:
      validation:
        presence:
          message: Suburb is required.
    state:
      validation:
        presence:
          message: State is required.
    postcode:
      validation:
        presence:
          message: Postcode is required.
    country:
      validation:
        presence:
          message: Country is required.
    latitude:
    longitude:
    geojson:
    # Social tab
    facebook_link:
    twitter_link:
    youtube_link:
    linkedin_link:
    instagram_link:
    snapchat_link:
async_callback_actions:
  delay: 0
  priority: low
  max_attempts: 2
  content: |-
    {%- comment -%}
      Auto-generate the location's `slug` after a successful profile save.
      Runs asynchronously after PlatformOS has persisted the form, so the
      user gets a fast response and the slug update happens out-of-band.

      Steps:
        1. Build a kebab-case `base` from the just-saved location_name.
           Liquid has no regex, so we hand-strip URL-unfriendly punctuation
           (full stops, commas, ampersands, quotes, etc. — these otherwise
           leak into the slug and break /find-a-partner/:slug routing, e.g.
           "Acme Co." -> "acme-co." -> 404), then map spaces/underscores to
           "-" and collapse any resulting double-dashes.
        2. Fetch only the rows whose slug starts with `base` (via
           starts_with filter), skip our own row (form.id), and pack the
           rest into a pipe-delimited haystack so `contains` can do
           uniqueness checks cheaply.
        3. Try `base`, then `base-2`, `base-3`, … up to 100, until one
           isn't in the haystack.
        4. record_update the slug onto the record we just saved.

      No-ops if location_name is blank or the kebab result is empty.
    {%- endcomment -%}
    {%- assign raw_name = form.properties.location_name | default: '' | strip -%}
    {%- if raw_name != '' -%}
      {%- assign base = raw_name
            | downcase
            | replace: '.', ''
            | replace: ',', ''
            | replace: "'", ''
            | replace: '"', ''
            | replace: '!', ''
            | replace: '?', ''
            | replace: '#', ''
            | replace: '&', ''
            | replace: '@', ''
            | replace: '$', ''
            | replace: '%', ''
            | replace: '*', ''
            | replace: '+', ''
            | replace: '=', ''
            | replace: ':', ''
            | replace: ';', ''
            | replace: '(', ''
            | replace: ')', ''
            | replace: '[', ''
            | replace: ']', ''
            | replace: '{', ''
            | replace: '}', ''
            | replace: '<', ''
            | replace: '>', ''
            | replace: '|', ''
            | replace: '~', ''
            | replace: '^', ''
            | replace: '`', ''
            | replace: '/', ''
            | replace: '\', ''
            | strip
            | replace: '_', '-'
            | replace: ' ', '-'
            | replace: '--', '-'
            | replace: '--', '-'
            | replace: '--', '-' -%}
      {%- if base != '' -%}
        {%- graphql slugs = 'modules/locator/locations/get_location_slugs', slug: base -%}
        {%- assign rows = slugs | dig: 'items','results' -%}
        {%- assign haystack = '' -%}
        {%- for row in rows -%}
          {%- unless row.id == form.id or row.slug == blank -%}
            {%- assign haystack = haystack | append: '|' | append: row.slug | append: '|' -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- assign final_slug = base -%}
        {%- for n in (1..100) -%}
          {%- capture probe -%}|{{ final_slug }}|{%- endcapture -%}
          {%- unless haystack contains probe -%}
            {%- break -%}
          {%- endunless -%}
          {%- assign suffix = n | plus: 1 -%}
          {%- assign final_slug = base | append: '-' | append: suffix -%}
        {%- endfor -%}
        {%- graphql slug_update = 'modules/locator/locations/update_location_slug', id: form.id, slug: final_slug -%}
      {%- endif -%}
    {%- endif -%}
---

{%- comment -%}
  Single unified form for the entire "My locator listing" page. Replaces the
  three per-tab forms (listing_profile / listing_location / listing_social)
  so that the user's edits across all tabs save in one submit. Tabs are
  visual chrome only — the field partials inject their inputs into this
  shared form, and one submit button lives below them.

  active_tab is computed by the page so that on server-side validation
  failure we surface the tab containing the first error.
{%- endcomment -%}
{%- form
    html-id: "listing-form"
    html-class: "insites-form insites-form-code"
    html-novalidate: true
    html-enctype: "multipart/form-data"
    html-onsubmit: "return LocatorPortal.validateForm(event);" -%}

  <ins-tab>
    <ins-tab-item label="Profile" {% if active_tab == 'profile' %}active{% endif %}>
      <div class="insites-form-grid">
        {% include 'modules/locator/portal/listing_profile_fields', data: data %}
      </div>
    </ins-tab-item>
    <ins-tab-item label="Location" {% if active_tab == 'location' %}active{% endif %}>
      <div class="insites-form-grid">
        {% include 'modules/locator/portal/listing_location_fields', data: data %}
      </div>
    </ins-tab-item>
    <ins-tab-item label="Social links" {% if active_tab == 'social' %}active{% endif %}>
      <div class="insites-form-grid">
        {% include 'modules/locator/portal/listing_social_fields', data: data %}
      </div>
    </ins-tab-item>
  </ins-tab>

  <div class="spacer x-large"></div>

  <div class="text-right">
    <ins-button
      label="Update details"
      icon="icon-check-2"
      type="submit"
      solid
      color="primary"
      id="listing-save-btn"
    ></ins-button>
  </div>

{%- endform -%}
