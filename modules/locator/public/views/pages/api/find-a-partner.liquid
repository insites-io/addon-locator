---
slug: api/locator/find-a-partner
format: json
method: get
searchable: false
metadata: {
    "status": "published",
    "page_name": "API | Locator | Find a Partner",
    "is_visible_to_search_engines": false,
    "sitemap_enabled": false
}
---

{%- assign lat_q      = context.params.lat      | strip -%}
{%- assign lng_q      = context.params.lng      | strip -%}
{%- assign distance_q = context.params.distance  | strip -%}
{%- assign location_q = context.params.location | strip -%}
{%- assign page_q     = context.params.page     | strip | plus: 0 -%}
{%- if page_q == 0 -%}{%- assign page_q = 1 -%}{%- endif -%}


{%- if lat_q != blank and lng_q != blank and distance_q != blank -%}
  {%- assign point_json = '{"type":"Point","coordinates":[' | append: lng_q | append: ',' | append: lat_q | append: ']}' -%}
  {%- assign point = point_json | parse_json -%}
  {%- assign distance_int = distance_q | plus: 0 -%}
  {%- graphql data  = "modules/locator/locations/get_locations_nearby", point: point, distance: distance_int, page: page_q -%}
  {%- graphql count = "modules/locator/locations/get_locations_nearby_total_entries", point: point, distance: distance_int, page: page_q -%}
{%- elsif location_q != blank -%}
  {%- graphql data  = "modules/locator/locations/get_locations", location: location_q -%}
  {%- graphql count = "modules/locator/locations/get_locations_total_entries", location: location_q -%}
{%- else -%}
  {%- graphql data  = "modules/locator/locations/get_locations" -%}
  {%- graphql count = "modules/locator/locations/get_locations_total_entries" -%}
{%- endif -%}

{%- capture cards_html -%}
  {%- for location in data.items.results -%}
    {%- include 'modules/locator/website/card' -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign response = '{}' | parse_json -%}
{%- assign response = response | add_hash_key: 'html',         cards_html -%}
{%- assign response = response | add_hash_key: 'total',        count.items.total_entries -%}
{%- assign response = response | add_hash_key: 'total_pages',  count.items.total_pages -%}
{%- assign response = response | add_hash_key: 'current_page', count.items.current_page -%}
{{ response | json }}
