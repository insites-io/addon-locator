{% comment %} Search Address — Google Places autocomplete (handled by address-lookup.js).
   address-lookup.js fills field IDs of the form `{name}_address_1`, `{name}_suburb`, etc.
   `name="listing"` is the prefix used for those IDs below.
{% endcomment %}
<div class="column-1">
  <ins-input
    address-lookup
    id="listing_address_search"
    name="listing"
    label="Search Address"
    placeholder="Search Address"
    icon="icon-map-pin"
  ></ins-input>
</div>

<input type="hidden" id="listing_latitude" name="{{ form.fields.properties.latitude.name }}" value="{{ data.latitude }}">
<input type="hidden" id="listing_longitude" name="{{ form.fields.properties.longitude.name }}" value="{{ data.longitude }}">
<input type="hidden" id="listing_geojson" name="{{ form.fields.properties.geojson.name }}" value="">


{% comment %} Address 1 {% endcomment %}
<div class="column-2">
  <ins-input
    form-address-field
    id="listing_address_1"
    label="Address 1*"
    name="{{ form.fields.properties.address_1.name }}"
    value="{{ data.address_1 }}"
    placeholder="Address 1"
    validate
    required
    {% if form.errors['address_1'] %} has-error {% endif %}
    error-message="{{ form.fields.properties.address_1.validation.rules.presence.message }}"
  ></ins-input>
</div>

