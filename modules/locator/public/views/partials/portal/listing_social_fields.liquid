{% comment %} Facebook {% endcomment %}
<div class="column-2">
  <ins-input
    label="Facebook"
    name="{{ form.fields.properties.facebook_link.name }}"
    value="{{ data.facebook_link }}"
    placeholder="https://facebook.com/your-page"
    url-field
  ></ins-input>
</div>

