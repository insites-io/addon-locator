---
metadata: {
    partial_name: 'Locator | Find a Partner | Details'
}
---

{%- assign partner_slug = context.params.slug2 | strip -%}
{%- graphql data = "modules/locator/locations/get_location_detail", slug: partner_slug -%}
{%- assign partner = data.items.results[0] -%}

{% if partner %}

  {%- comment -%} Build address — strip each part since stored values may have trailing whitespace. {%- endcomment -%}
  {%- assign address_parts = '' -%}
  {%- assign address_1 = partner.address_1 | strip -%}
  {%- assign address_2 = partner.address_2 | strip -%}
  {%- assign suburb = partner.suburb | strip -%}
  {%- assign state = partner.state | strip -%}
  {%- assign postcode = partner.postcode | strip -%}
  {%- if address_1 != '' -%}
    {%- assign address_parts = address_1 -%}
  {%- endif -%}
  {%- if address_2 != '' -%}
    {%- assign address_parts = address_parts | append: ', ' | append: address_2 -%}
  {%- endif -%}
  {%- if suburb != '' -%}
    {%- assign address_parts = address_parts | append: ', ' | append: suburb -%}
  {%- endif -%}
  {%- if state != '' -%}
    {%- assign address_parts = address_parts | append: ' ' | append: state -%}
  {%- endif -%}
  {%- if postcode != '' -%}
    {%- assign address_parts = address_parts | append: ' ' | append: postcode -%}
  {%- endif -%}

  {%- comment -%} Build phone {%- endcomment -%}
  {%- assign phone_full = '' -%}
  {%- if partner.phone_number and partner.phone_number != '' -%}
    {%- if partner.phone_country_code and partner.phone_country_code != '' -%}
      {%- assign phone_full = '+' | append: partner.phone_country_code | append: ' ' | append: partner.phone_number -%}
    {%- else -%}
      {%- assign phone_full = partner.phone_number -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} Strip HTML from short description for inline use {%- endcomment -%}
  {%- assign tagline = partner.short_description | strip_html | strip -%}

  {%- comment -%} Slugs seeded by /migrations/20260525012058_locations.liquid — their logos ship as static assets in /assets/images. Uploaded location_image takes precedence. {%- endcomment -%}
  {%- assign seeded_logo_slugs = 'harbour-city-partners,blue-bay-digital,top-end-tech,cummin-consulting,surf-coast-studios,brooklyn-simmons,bellarine-brands,outback-web-solutions,quokka-creative,wombat-marketing,tasman-digital,capital-e-commerce,fremantle-founders,red-dirt-agencies,nextgen-consultants-agency,steel-city-digital,kangaroo-commerce' | split: ',' -%}
  {%- if partner.location_image.url and partner.location_image.url != blank -%}
    {%- assign logo_url = partner.location_image.url -%}
  {%- elsif seeded_logo_slugs contains partner.slug -%}
    {%- assign logo_url = 'modules/locator/images/' | append: partner.slug | append: '.png' | asset_url -%}
  {%- endif -%}

  {%- comment -%} Banner — LCP candidate, prioritise fetch and provide dimensions to reserve space. {%- endcomment -%}
  <div class="locator-profile-banner{% unless partner.image_1.url %} no-banner{% endunless %}">
    {%- if partner.image_1.url -%}
      <img src="{{ partner.image_1.url | replace: ' ', '%20' }}" alt="" class="locator-profile-banner__img" aria-hidden="true" width="1920" height="600" fetchpriority="high" decoding="async">
    {%- endif -%}
    <div class="locator-profile-banner__overlay" aria-hidden="true"></div>
  </div>

  {%- comment -%} Profile heading: logo + identity + actions {%- endcomment -%}
  <div class="locator-profile-heading-wrap">
    <div class="locator-profile-heading">
      <div class="locator-profile-heading__row">

        <div class="locator-profile-logo-col">
          <div class="locator-profile-logo">
            {%- if logo_url != blank -%}
              <img src="{{ logo_url | replace: ' ', '%20' }}" alt="{{ partner.location_name | escape }}" width="97" height="97" decoding="async">
            {%- else -%}
              {%- include 'modules/website/layout/placeholder_image' -%}
            {%- endif -%}
          </div>
        </div>

        <div class="locator-profile-identity-col">
          <div class="locator-profile-identity">
            <div class="locator-profile-identity__name-row">
              <h1 class="heading-1-xsmall">{{ partner.location_name }}</h1>
              {%- if partner.category.slug -%}
                <ins-tag
                  class="locator-tag locator-tag--{{ partner.category.slug }}"
                  label="{{ partner.category.name }}"
                  icon="icon-check-2"
                ></ins-tag>
              {%- endif -%}
            </div>
            {%- if tagline != '' -%}
              <p class="locator-profile-identity__tagline">{{ tagline }}</p>
            {%- endif -%}
            <div class="locator-profile-identity__spacer"></div>
          </div>
        </div>

        {%- if partner.website and partner.website != '' -%}
          <div class="locator-profile-actions-col">
            <div class="locator-profile-actions">
              <a href="{{ partner.website | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Open website (opens in new tab)">
                <ins-button
                  label="Open website"
                  icon-right="icon-arrow-up-right"
                  solid
                  color="primary"
                  class="full-width"
                  aria-hidden="true"
                ></ins-button>
              </a>
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>

  {%- comment -%} Main content {%- endcomment -%}
  <div class="locator-profile-page-content">
    <div class="locator-profile-content">
      <div class="locator-profile-body">

        <div class="locator-profile-main">
          {%- if partner.long_description and partner.long_description != '' -%}
            {%- comment -%}
              Sanitise the rich-text body before output:
              1. Strip <grammarly-extension> wrappers injected by the Grammarly browser extension
                 while the partner edited the field in ins-editor. They're saved into the DB but
                 should never reach the public page. Open-tag prefix + closing tag are constant;
                 attributes vary, so we rewrite them to <span hidden …> which neutralises them.
              2. Add lazy-loading hints to any <img> since these sit below the fold.
            {%- endcomment -%}
            {%- assign long_description_clean = partner.long_description
                | replace: '<grammarly-extension', '<span hidden'
                | replace: '</grammarly-extension>', '</span>'
                | replace: '<img ', '<img loading="lazy" decoding="async" ' -%}
            <div class="locator-profile-section__body">{{ long_description_clean }}</div>
          {%- endif -%}
        </div>

        <aside class="locator-profile-sidebar">
          <div class="locator-profile-contact-card">

            <h2 class="locator-profile-contact-card__title">Contact us</h2>
            <div class="spacer small"></div>

            <div class="locator-profile-contact-list">
              {%- if address_parts != '' -%}
                <div class="locator-profile-contact-row">
                  <i class="icon-map-pin" aria-hidden="true"></i>
                  <span>{{ address_parts }}</span>
                </div>
              {%- endif -%}
              {%- if phone_full != '' -%}
                {%- comment -%} tel: URIs allow `+` and digits; strip spaces so dialers parse it cleanly. {%- endcomment -%}
                {%- assign phone_dial = phone_full | remove: ' ' -%}
                <div class="locator-profile-contact-row">
                  <i class="icon-phone-1" aria-hidden="true"></i>
                  <a href="tel:{{ phone_dial | escape }}">{{ phone_full }}</a>
                </div>
              {%- endif -%}
              {%- if partner.email and partner.email != '' -%}
                <div class="locator-profile-contact-row">
                  <i class="icon-email-1" aria-hidden="true"></i>
                  <a href="mailto:{{ partner.email | escape }}">{{ partner.email }}</a>
                </div>
              {%- endif -%}
              {%- if partner.website and partner.website != '' -%}
                <div class="locator-profile-contact-row">
                  <i class="icon-globals" aria-hidden="true"></i>
                  <a href="{{ partner.website | escape }}" target="_blank" rel="noopener noreferrer">
                    {{- partner.website | remove: 'https://' | remove: 'http://' | remove: 'www.' -}}
                    <span class="show-for-sr"> (opens in new tab)</span>
                  </a>
                </div>
              {%- endif -%}
            </div>

            {%- assign has_social = false -%}
            {%- if partner.facebook_link and partner.facebook_link != '' -%}{%- assign has_social = true -%}{%- endif -%}
            {%- if partner.twitter_link and partner.twitter_link != '' -%}{%- assign has_social = true -%}{%- endif -%}
            {%- if partner.instagram_link and partner.instagram_link != '' -%}{%- assign has_social = true -%}{%- endif -%}
            {%- if partner.linkedin_link and partner.linkedin_link != '' -%}{%- assign has_social = true -%}{%- endif -%}
            {%- if partner.youtube_link and partner.youtube_link != '' -%}{%- assign has_social = true -%}{%- endif -%}

            {%- if has_social -%}
              <div class="spacer large"></div>
              <h2 class="locator-profile-contact-card__title">Follow us</h2>
              <div class="spacer small"></div>
              <div class="locator-profile-social">
                {%- if partner.facebook_link and partner.facebook_link != '' -%}
                  <a href="{{ partner.facebook_link | escape }}" target="_blank" rel="noopener noreferrer" class="locator-profile-social__link" aria-label="{{ partner.location_name | escape }} on Facebook (opens in new tab)">
                    <i class="icon-facebook-square" aria-hidden="true"></i>
                  </a>
                {%- endif -%}
                {%- if partner.twitter_link and partner.twitter_link != '' -%}
                  <a href="{{ partner.twitter_link | escape }}" target="_blank" rel="noopener noreferrer" class="locator-profile-social__link" aria-label="{{ partner.location_name | escape }} on X / Twitter (opens in new tab)">
                    <i class="icon-social-x-square" aria-hidden="true"></i>
                  </a>
                {%- endif -%}
                {%- if partner.instagram_link and partner.instagram_link != '' -%}
                  <a href="{{ partner.instagram_link | escape }}" target="_blank" rel="noopener noreferrer" class="locator-profile-social__link" aria-label="{{ partner.location_name | escape }} on Instagram (opens in new tab)">
                    <i class="icon-instagram-square" aria-hidden="true"></i>
                  </a>
                {%- endif -%}
                {%- if partner.linkedin_link and partner.linkedin_link != '' -%}
                  <a href="{{ partner.linkedin_link | escape }}" target="_blank" rel="noopener noreferrer" class="locator-profile-social__link" aria-label="{{ partner.location_name | escape }} on LinkedIn (opens in new tab)">
                    <i class="icon-linkedin" aria-hidden="true"></i>
                  </a>
                {%- endif -%}
                {%- if partner.youtube_link and partner.youtube_link != '' -%}
                  <a href="{{ partner.youtube_link | escape }}" target="_blank" rel="noopener noreferrer" class="locator-profile-social__link" aria-label="{{ partner.location_name | escape }} on YouTube (opens in new tab)">
                    <i class="icon-youtube-square" aria-hidden="true"></i>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

          </div>
        </aside>

      </div>
    </div>
  </div>

{% else %}

  {%- redirect_to '/404' -%}

{% endif %}
