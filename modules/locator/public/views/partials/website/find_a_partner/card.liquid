---
metadata: {
    partial_name: 'Locator | Find a Partner | Card'
}
---

{% assign desc = location.short_description | strip_html | strip %}

{%- comment -%} Build address — strip each part since stored values may have trailing whitespace. {%- endcomment -%}
{% assign address = '' %}
{% assign address_1 = location.address_1 | strip %}
{% assign address_2 = location.address_2 | strip %}
{% assign suburb = location.suburb | strip %}
{% assign state = location.state | strip %}
{% assign postcode = location.postcode | strip %}
{% if address_1 != '' %}
  {% assign address = address_1 %}
{% endif %}
{% if address_2 != '' %}
  {% assign address = address | append: ', ' | append: address_2 %}
{% endif %}
{% if suburb != '' %}
  {% assign address = address | append: ', ' | append: suburb %}
{% endif %}
{% if state != '' %}
  {% assign address = address | append: ' ' | append: state %}
{% endif %}
{% if postcode != '' %}
  {% assign address = address | append: ' ' | append: postcode %}
{% endif %}

{% assign phone = '' %}
{% if location.phone_number %}
  {% if location.phone_country_code %}
    {% assign phone = '+' | append: location.phone_country_code | append: ' ' %}
  {% endif %}
  {% assign phone = phone | append: location.phone_number %}
{% endif %}

{% assign category_name = '' %}
{% if location.category %}
  {% assign category_name = location.category.name %}
{% endif %}

{%- comment -%} Slugs seeded by /migrations/20260525012058_locations.liquid — their logos ship as static assets in /assets/images. {%- endcomment -%}
{% assign seeded_logo_slugs = 'harbour-city-partners,blue-bay-digital,top-end-tech,cummin-consulting,surf-coast-studios,brooklyn-simmons,bellarine-brands,outback-web-solutions,quokka-creative,wombat-marketing,tasman-digital,capital-e-commerce,fremantle-founders,red-dirt-agencies,nextgen-consultants-agency,steel-city-digital,kangaroo-commerce' | split: ',' %}
{% if seeded_logo_slugs contains location.slug %}
  {% assign logo_url = 'modules/locator/images/' | append: location.slug | append: '.png' | asset_url %}
{% else %}
  {% assign logo_url = location.location_image.url %}
{% endif %}

<a href="/find-a-partner/{{ location.slug }}" class="locator-card"
   data-lat="{{ location.latitude }}" data-lng="{{ location.longitude }}"
   data-name="{{ location.location_name | escape }}"
   data-type="{{ category_name | escape }}"
   data-desc="{{ desc | escape }}"
   data-address="{{ address | escape }}"
   data-phone="{{ phone | escape }}"
   data-logo="{{ logo_url | replace: ' ', '%20' | escape }}"
   {% if location.category %}data-tag="{{ location.category.slug }}" data-tag-label="{{ location.category.name | escape }}"{% endif %}>
  <div class="locator-card__logo">
    {% if logo_url != blank %}
      <img src="{{ logo_url | replace: ' ', '%20' }}" alt="{{ location.location_name | escape }}" width="96" height="96" loading="lazy" decoding="async">
    {% else %}
      {%- include 'modules/website/layout/placeholder_image' -%}
    {% endif %}
  </div>
  <div class="locator-card__body">
    <div class="locator-card__header">
      <div class="locator-card__identity">
        <p class="locator-card__name">{{ location.location_name }}</p>
      </div>
      {% if location.category %}
        <ins-tag
          class="locator-tag locator-tag--{{ location.category.slug }}"
          label="{{ location.category.name }}"
          icon="icon-check-2"
        ></ins-tag>
      {% endif %}
    </div>
    {% if desc != '' %}
      <p class="locator-card__desc">{{ desc }}</p>
    {% endif %}
    {% if address != '' %}
      <p class="locator-card__meta"><i class="icon-map-pin" aria-hidden="true"></i> {{ address }}</p>
    {% endif %}
    {% if phone != '' %}
      <p class="locator-card__meta"><i class="icon-phone-1" aria-hidden="true"></i> {{ phone }}</p>
    {% endif %}
  </div>
</a>
