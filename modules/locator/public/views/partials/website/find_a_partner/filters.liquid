---
metadata: {
    partial_name: 'Locator | Find a Partner | Filters'
}
---

<section class="locator-filters-section">
  {% comment %} Visually hidden — gives the section an entry in the heading outline for screen-reader navigation and W3C "section lacks heading" compliance. {% endcomment %}
  <h2 class="show-for-sr">Search and filter partners</h2>
  <div class="wrapper">
    <div class="grid-container">

      {% comment %} Search bar {% endcomment %}
      <div class="locator-search-bar">

        <div class="locator-search-bar__left">
          <ins-input
            id="locator-location"
            name="locator"
            address-lookup
            placeholder="Enter your Suburb or Post Code"
            icon="icon-search-1"
          ></ins-input>
          {% comment %} Hidden inputs populated by AddressLookup when a suggestion is picked. Read in doSearch() to skip the geocoder fallback. {% endcomment %}
          <input type="hidden" id="locator_latitude" name="locator_latitude">
          <input type="hidden" id="locator_longitude" name="locator_longitude">

          <ins-input-select
            id="locator-distance"
            placeholder="Distance"
            value="15"
            disabled
          >
            <ins-input-select-option label="5 km" value="5"></ins-input-select-option>
            <ins-input-select-option label="10 km" value="10"></ins-input-select-option>
            <ins-input-select-option label="15 km" value="15"></ins-input-select-option>
            <ins-input-select-option label="25 km" value="25"></ins-input-select-option>
            <ins-input-select-option label="50 km" value="50"></ins-input-select-option>
            <ins-input-select-option label="100+ km" value="100"></ins-input-select-option>
          </ins-input-select>
          
          <ins-button
            id="locator-search-btn"
            label="Find a partner"
            icon="icon-search-1"
            solid
            color="primary"
            class="full-width"
          ></ins-button>
        </div>

        <div class="locator-search-bar__right">
          <ins-button
            id="locator-filters-btn"
            label="Filters"
            icon="icon-filter"
            outlined
            color="primary"
            class="full-width"
          ></ins-button>
        </div>

      </div>

      {% comment %} Controls bar {% endcomment %}
      <div class="spacer xx-small"></div>

      <div class="locator-controls">
        <p class="locator-controls__status" id="locator-status" aria-live="polite" aria-atomic="true">Enter a location to find partners near you.</p>
        <div class="locator-controls__view">
          <span class="locator-controls__view-label">View:</span>
          <button class="locator-view-btn is-active" type="button" id="locator-list-view-btn" data-view="list" aria-label="List view" aria-pressed="true">
            <i class="icon-list" aria-hidden="true"></i>
          </button>
          <button class="locator-view-btn" type="button" id="locator-grid-view-btn" data-view="grid" aria-label="Grid view" aria-pressed="false">
            <i class="icon-grid" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div class="spacer"></div>

    </div>

  </div>
</section>

{% comment %} Drawer is injected by locator.js on first filters-button click to avoid an unused <ins-drawer> custom-element upgrade on initial paint. {% endcomment %}
