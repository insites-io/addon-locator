{% comment %} Locator Addon {% endcomment %}
{% graphql create_constant, name: 'locator_addon', value: 'true' %}
  mutation constant_set(
  $name: String
  $value: String
) {
  constant_set(name: $name, value: $value) {
    value
    name
  }
}
{% endgraphql %}
{% log create_constant, type: "Constants Created: locator_addon" %}


